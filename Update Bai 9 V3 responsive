    function loadVoices() {
      if (!('speechSynthesis' in window) || !window.speechSynthesis) return;
      try {
        var all = window.speechSynthesis.getVoices() || [];
        var viVoices = all.filter(function(v) {
          var lang = (v.lang || '').toLowerCase();
          var name = (v.name || '').toLowerCase();
          return lang.indexOf('vi') !== -1 || name.indexOf('vietnam') !== -1 || name.indexOf('tieng viet') !== -1;
        });

        // ƯU TIÊN TUYỆT ĐỐI GIỌNG NỮ MIỀN BẮC (Hoài My, Google tiếng Việt, Linh, Mai, Hương)
        viVoices.sort(function(a, b) {
          var nameA = (a.name || '').toLowerCase();
          var nameB = (b.name || '').toLowerCase();
          function score(name) {
            if (name.indexOf('hoaimy') !== -1 || name.indexOf('hoài my') !== -1) return 100;
            if (name.indexOf('google') !== -1 && (name.indexOf('vi') !== -1 || name.indexOf('tiếng việt') !== -1)) return 95;
            if (name.indexOf('mai') !== -1 || name.indexOf('linh') !== -1 || name.indexOf('huong') !== -1) return 90;
            if (name.indexOf('female') !== -1 || name.indexOf('nữ') !== -1) return 85;
            // Giọng nam xếp cuối cùng để không bị đọc giọng nam
            if (name.indexOf('nam') !== -1 || name.indexOf('an') !== -1 || name.indexOf('male') !== -1 || name.indexOf('tuan') !== -1) return -50;
            return 10;
          }
          return score(nameB) - score(nameA);
        });

        cachedVoices = viVoices;
      } catch(e){}
    }

    if ('speechSynthesis' in window && window.speechSynthesis) {
      loadVoices();
      if (window.speechSynthesis.onvoiceschanged !== undefined) {
        window.speechSynthesis.onvoiceschanged = loadVoices;
      }
    }

    function stopAllAudio() {
      isVoiceActive = false;
      updateAudioButtonUI();
