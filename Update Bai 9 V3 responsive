    function speakCurrentSlide() {
      var s = slides[currentIndex];
      if (!s) return;

      // Unlock browser audio context gesture
      playAudioTone('select');

      // 1. If slide has pre-rendered Northern Female AI audio OR teacher recorded audio, play directly!
      var audioSrc = s.recordedAudioUrl || s.narrationAudioUrl;
      var recAudio = document.getElementById('slide-recorded-audio');
      if (audioSrc && recAudio) {
        try {
          isVoiceActive = true;
          updateAudioButtonUI();
          recAudio.currentTime = 0;
          recAudio.playbackRate = voiceRate;
          recAudio.volume = 1.0;
          recAudio.muted = false;
          var playPromise = recAudio.play();
          if (playPromise !== undefined) {
            playPromise.then(function() {
              isVoiceActive = true;
              updateAudioButtonUI();
            }).catch(function(err) {
              console.warn('Audio play notice, falling back to synthesis:', err);
              speakWithSynthesis(s);
            });
          }
          recAudio.onended = function() {
            isVoiceActive = false;
            updateAudioButtonUI();
          };
          return;
        } catch(err) {
          console.warn('Error playing audio file:', err);
        }
      }

      speakWithSynthesis(s);
    }

    function speakWithSynthesis(s) {
      if (!s || !s.audioScript) {
        isVoiceActive = false;
        updateAudioButtonUI();
        return;
      }
      if (!('speechSynthesis' in window) || !window.speechSynthesis) {
        isVoiceActive = false;
        updateAudioButtonUI();
        return;
      }

      try {
        if (window.speechSynthesis.paused) {
          window.speechSynthesis.resume();
        }
        window.speechSynthesis.cancel();

        var textToSpeak = normalizeVietnameseSpeechText(s.audioScript);
        var utter = new SpeechSynthesisUtterance(textToSpeak);
        utter.rate = voiceRate;
        utter.lang = 'vi-VN';

        if (!cachedVoices || cachedVoices.length === 0) {
          loadVoices();
        }

        if (cachedVoices && cachedVoices.length > 0) {
          var chosenVoice = cachedVoices[0];
          utter.voice = chosenVoice;
          utter.lang = chosenVoice.lang || 'vi-VN';

          var vName = (chosenVoice.name || '').toLowerCase();
          var isMale = vName.indexOf('nam') !== -1 || vName.indexOf('an') !== -1 || vName.indexOf('male') !== -1 || vName.indexOf('tuan') !== -1;
          // Nếu chỉ có giọng nam trên hệ thống, nâng cao độ pitch lên 1.25 để tạo âm sắc nữ thanh thoát
          utter.pitch = isMale ? 1.25 : 1.05;
        } else {
          // TUYỆT ĐỐI KHÔNG dùng giọng tiếng Anh đọc tiếng Việt!
          showAudioNotice('Thiết bị chưa có sẵn gói giọng đọc tiếng Việt offline (vi-VN). Hãy bật mạng Internet hoặc cài đặt gói tiếng Việt trên máy tính.');
          isVoiceActive = false;
          updateAudioButtonUI();
          return;
        }

        utter.onstart = function() {
          isVoiceActive = true;
          updateAudioButtonUI();
        };

        utter.onend = function() {
          isVoiceActive = false;
          updateAudioButtonUI();
        };

        utter.onerror = function(e) {
          console.warn('Speech synthesis notice:', e);
          isVoiceActive = false;
          updateAudioButtonUI();
        };

        isVoiceActive = true;
        updateAudioButtonUI();
        window.speechSynthesis.speak(utter);

        // Chrome SpeechSynthesis auto-pause watchdog fix
        if (window._speechWatchdog) clearInterval(window._speechWatchdog);
        window._speechWatchdog = setInterval(function() {
          if (isVoiceActive && window.speechSynthesis && window.speechSynthesis.speaking && window.speechSynthesis.paused) {
            window.speechSynthesis.resume();
          }
        }, 3000);
      } catch(err) {
        console.warn('Speech error:', err);
        isVoiceActive = false;
        updateAudioButtonUI();
      }
    }

    function toggleAudio() {
      if (isVoiceActive) {
        stopAllAudio();
      } else {
        speakCurrentSlide();
