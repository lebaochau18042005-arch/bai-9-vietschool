      if (!url) return false;
      return url.indexOf('media/') === 0 ||
             url.indexOf('blob:') === 0 ||
             url.indexOf('data:') === 0 ||
             url.indexOf('.mp4') !== -1 ||
             url.indexOf('.webm') !== -1 ||
             url.indexOf('.ogg') !== -1 ||
             url.indexOf('.mov') !== -1 ||
             url.indexOf('.mkv') !== -1 ||
             url.indexOf('video/') !== -1;
    }

    function getYouTubeEmbedUrl(url) {
      if (!url) return '';
      if (url.indexOf('embed/') !== -1) return url;
      var videoId = '';
      if (url.indexOf('v=') !== -1) {
        videoId = url.split('v=')[1].split('&')[0];
      } else if (url.indexOf('youtu.be/') !== -1) {
        videoId = url.split('youtu.be/')[1].split('?')[0];
      }
      return ''; // Offline VietSchool build: external video embeds disabled
