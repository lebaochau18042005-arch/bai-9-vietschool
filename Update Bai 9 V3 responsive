    function speakCustomText(text) {
      if (!('speechSynthesis' in window) || !window.speechSynthesis) return;
      try {
        window.speechSynthesis.cancel();
        var norm = normalizeVietnameseSpeechText(text);
        var utter = new SpeechSynthesisUtterance(norm);
        utter.lang = 'vi-VN';
        utter.rate = voiceRate;
        if (!cachedVoices || cachedVoices.length === 0) loadVoices();
        if (cachedVoices && cachedVoices.length > 0) {
          utter.voice = cachedVoices[0];
          utter.lang = cachedVoices[0].lang || 'vi-VN';
          var vName = (cachedVoices[0].name || '').toLowerCase();
          var isMale = vName.indexOf('nam') !== -1 || vName.indexOf('male') !== -1;
          utter.pitch = isMale ? 1.25 : 1.05;
        }
        window.speechSynthesis.speak(utter);
      } catch(e){}
    }

