    function submitQuiz() {
      var totalPoints = 0;
      quizQuestions.forEach(function(q) {
        if (q.type === 'multiple_choice') {
          if (mcqAnswers[q.id] === q.correctAnswerIndex) {
            totalPoints += (q.level === 'Nhận biết' ? 10 : 15);
          }
        } else if (q.type === 'true_false') {
          var userStmts = tfAnswers[q.id] || [];
          (q.statements || []).forEach(function(stmt, idx) {
            if (userStmts[idx] === stmt.isTrue) totalPoints += 5;
          });
        } else if (q.type === 'short_answer') {
          var ans = (saAnswers[q.id] || '').trim().toLowerCase();
          var matched = (q.acceptableAnswers || []).some(function(acc) {
            var c = acc.trim().toLowerCase();
            return ans === c || ans.indexOf(c) !== -1;
          });
          if (matched) totalPoints += 10;
        }
      });

      quizScore = totalPoints;
      isQuizSubmitted = true;
      var passed = quizScore >= 80;

      if (passed) {
        playAudioTone('correct');
        triggerConfettiEffect();
      } else {
        playAudioTone('incorrect');
      }

      window.recordScormProgress(currentIndex, slides.length, quizScore, passed);
      renderQuizStage();
    }

    function retakeQuiz() {
      mcqAnswers = {};
