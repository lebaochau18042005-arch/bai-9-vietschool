          html += '<div class="flex items-center gap-1.5 mb-2 pb-2 border-b border-slate-800 text-xs overflow-x-auto">';
          mediaTabList.forEach(function(t) {
            html += '<button type="button" onclick="switchMediaTab(\'' + t.id + '\')" class="px-2.5 py-1 rounded-lg text-xs font-bold transition cursor-pointer shrink-0 ' +
              (activeTab === t.id ? 'bg-emerald-600 text-white shadow-sm ring-1 ring-emerald-400' : 'bg-slate-800 text-slate-400 hover:text-white') + '">' +
              t.label + '</button>';
          });
          html += '</div>';
        }

        html += '<div class="flex-1 flex flex-col justify-center items-center overflow-hidden w-full">';

        if (activeTab === 'diagram' && s.diagramType) {
          html += '<div class="w-full h-full min-h-[300px] overflow-y-auto">';
          html += renderInteractiveDiagram(s.diagramType);
          html += '</div>';
        } else if (activeTab === 'video' && s.videoUrl) {
          html += '<div class="w-full flex flex-col justify-center items-center space-y-2">';
          if (isDirectVideo(s.videoUrl)) {
            html += '<video id="slide-video" controls playsinline preload="auto" class="lesson-video w-full rounded-2xl shadow-xl bg-black object-contain border border-slate-700">' +
              '<source src="' + s.videoUrl + '">' +
              '<source src="' + s.videoUrl + '" type="video/mp4">' +
              '<source src="' + s.videoUrl + '" type="video/webm">' +
              'Trình duyệt không hỗ trợ thẻ video HTML5.' +
              '</video>' +
              '<div class="flex items-center justify-between w-full px-1 text-[11px] text-slate-300 gap-2 mt-2">' +
              '<span class="text-emerald-400 font-semibold flex items-center gap-1"><span>🔊</span> Video có âm thanh. Hãy bật loa máy tính.</span>' +
              '<button type="button" onclick="var v = document.getElementById(\'slide-video\'); if (v) { v.muted = false; v.volume = 1.0; v.play(); }" class="px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs cursor-pointer shadow transition flex items-center gap-1">' +
              '<span>▶🔊</span> Mở tiếng & Phát video' +
              '</button>' +
              '</div>';
          } else {
            html += '<div class="w-full rounded-xl border border-slate-700 bg-slate-900 p-6 text-center text-slate-300">Video trực tuyến đã được tắt trong bản OFFLINE VietSchool.</div>';
          }
          html += '</div>';
        } else if (s.imageUrl) {
          html += '<div class="w-full flex flex-col justify-center items-center">' +
            '<img src="' + s.imageUrl + '" alt="' + s.title + '" class="rounded-xl max-h-60 object-contain shadow-lg w-full">' +
            (s.imageCaption ? '<p class="text-[11px] text-slate-400 mt-2 text-center italic">' + s.imageCaption + '</p>' : '') +
            '</div>';
        }

        html += '</div></div>';
      }

      html += '</div>';

      // Audio narration script bar
      var audioSrc = s.recordedAudioUrl || s.narrationAudioUrl;
      if (s.audioScript || audioSrc) {
        html += '<div class="mt-3 p-3 bg-slate-950/90 rounded-2xl border border-slate-800 text-xs text-slate-300 flex flex-wrap items-center justify-between gap-3 shrink-0 shadow-lg">' +
          '<div class="flex items-center gap-2.5 flex-1 min-w-[200px]">' +
          '<span class="text-base text-emerald-400 shrink-0">🎙️</span>' +
          '<div class="flex flex-col">' +
          '<span class="text-[10px] text-amber-400 uppercase font-bold tracking-wide">Thuyết minh giọng Nữ miền Bắc (Chuẩn tiếng Việt):</span>' +
          '<span class="text-xs text-slate-200 italic line-clamp-2">"' + (s.audioScript || 'Lời giảng thuyết minh bài học') + '"</span>' +
          '</div></div>' +
          '<div class="flex items-center gap-2 shrink-0">' +
          (audioSrc ? '<audio id="slide-recorded-audio" src="' + audioSrc + '" controls class="h-8 max-w-[180px]"></audio>' : '') +
          '<button type="button" onclick="speakCurrentSlide()" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-xs shadow transition cursor-pointer flex items-center gap-1.5">' +
          '<span>🔊</span> ' + (isVoiceActive ? 'Đang phát' : 'Nghe thuyết minh Nữ miền Bắc') +
          '</button>' +
          (isVoiceActive ? '<button type="button" onclick="stopAllAudio()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold cursor-pointer">⏹ Dừng</button>' : '') +
          '</div>' +
          '</div>';
      }

      html += '</div>';
      stage.innerHTML = html;

      var vid = document.getElementById('slide-video');
      if (vid) {
        try {
          vid.volume = 1.0;
          vid.muted = false;
        } catch(e){}
      }

      window.recordScormProgress(currentIndex, slides.length);
    }

    document.addEventListener('keydown', function(e) {
      if (['INPUT', 'TEXTAREA'].indexOf((e.target || {}).tagName) !== -1) return;
      if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault();
        nextSlide();
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        prevSlide();
      } else if (e.key === 'Home') {
        goToSlide(0);
      } else if (e.key === 'End') {
        goToSlide(slides.length - 1);
      }
    });

    // Start playback. Keep a visible diagnostic fallback if rendering is blocked by the host.
    try {
      renderSlide();
    } catch (err) {
      console.error('VietSchool embed render error:', err);
      var stage = document.getElementById('slide-stage');
      if (stage) {
        stage.innerHTML = '<div style="padding:24px;color:#f8fafc;background:#0f172a;border:1px solid #334155;border-radius:16px"><b>Không thể khởi tạo bài giảng.</b><br><span style="color:#cbd5e1">Vui lòng mở lại học liệu hoặc báo giáo viên. Mã lỗi: ' + String(err && err.message ? err.message : err) + '</span></div>';
      }
    }
  </script>
</body>
</html>
