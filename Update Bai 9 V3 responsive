    function normalizeVietnameseSpeechText(text) {
      if (!text) return '';
      var normalized = text;
      normalized = normalized.replace(/(-?\d+[\.,]\d+)°C\s*\/\s*100m/gi, '$1 độ C trên một trăm mét');
      normalized = normalized.replace(/(-?\d+)°C\s*\/\s*100m/gi, '$1 độ C trên một trăm mét');
      normalized = normalized.replace(/(-?\d+[\.,]\d+)°C/gi, '$1 độ C');
      normalized = normalized.replace(/(-?\d+)°C/gi, '$1 độ C');
      normalized = normalized.replace(/(\d+)°B\b/gi, '$1 độ Bắc');
      normalized = normalized.replace(/(\d+)°N\b/gi, '$1 độ Nam');
      normalized = normalized.replace(/0°\b/gi, 'không độ xích đạo');
      normalized = normalized.replace(/760\s*mmHg/gi, 'bảy trăm sáu mươi milimét thủy ngân');
      normalized = normalized.replace(/1[\.\s,]013\s*mb/gi, 'một nghìn không trăm mười ba milibar');
      normalized = normalized.replace(/(\d+[\.,\d]*)\s*mm\/năm/gi, '$1 milimét trên năm');
      normalized = normalized.replace(/(\d+[\.,\d]*)\s*mm\b/gi, '$1 milimét');
      normalized = normalized.replace(/(\d+[\.,\d]*)\s*km\b/gi, '$1 kilômét');
      normalized = normalized.replace(/(\d+[\.,\d]*)\s*m\b/gi, '$1 mét');
      normalized = normalized.replace(/\b0[,\.]6\b/g, 'không phẩy sáu');
      normalized = normalized.replace(/\b1[,\.]0\b/g, 'một phẩy không');
      normalized = normalized.replace(/\b1[,\.]8\b/g, 'một phẩy tám');
      normalized = normalized.replace(/\b7[,\.]4\b/g, 'bảy phẩy bốn');
      normalized = normalized.replace(/\b24[,\.]5\b/g, 'hai mươi tư phẩy năm');
      normalized = normalized.replace(/\b25[,\.]0\b/g, 'hai mươi lăm');
      normalized = normalized.replace(/\b20[,\.]4\b/g, 'hai mươi phẩy bốn');
      normalized = normalized.replace(/\b14[,\.]0\b/g, 'mười bốn');
      normalized = normalized.replace(/\b5[,\.]4\b/g, 'năm phẩy bốn');
      normalized = normalized.replace(/\b-0[,\.]6\b/g, 'âm không phẩy sáu');
      normalized = normalized.replace(/\b-10[,\.]4\b/g, 'âm mười phẩy bốn');
      normalized = normalized.replace(/\b32[,\.]2\b/g, 'ba mươi hai phẩy hai');
      normalized = normalized.replace(/\b29[,\.]0\b/g, 'hai mươi chín');
      normalized = normalized.replace(/\b23[,\.]8\b/g, 'hai mươi ba phẩy tám');
      normalized = normalized.replace(/\b17[,\.]7\b/g, 'mười bảy phẩy bảy');
      normalized = normalized.replace(/\b13[,\.]3\b/g, 'mười ba phẩy ba');
      normalized = normalized.replace(/\bGDPT\s*2018\b/gi, 'giáo dục phổ thông hai nghìn không trăm mười tám');
      normalized = normalized.replace(/\bKNTT\b/gi, 'kết nối tri thức');
      normalized = normalized.replace(/\bTHPT\b/gi, 'trung học phổ thông');
      normalized = normalized.replace(/\bSGK\b/gi, 'sách giáo khoa');
      normalized = normalized.replace(/\bFIT\b/g, 'dải hội tụ nhiệt đới');
      normalized = normalized.replace(/\bFA\b/g, 'frông địa cực');
      normalized = normalized.replace(/\bFP\b/g, 'frông ôn đới');
      normalized = normalized.replace(/\bΔT\b/g, 'đenta T');
      normalized = normalized.replace(/\bΔh\b/g, 'đenta h');
      normalized = normalized.replace(/\bkhối khí\s*\(A\)/gi, 'khối khí cực A');
      normalized = normalized.replace(/\bkhối khí\s*\(P\)/gi, 'khối khí ôn đới P');
      normalized = normalized.replace(/\bkhối khí\s*\(T\)/gi, 'khối khí chí tuyến T');
      normalized = normalized.replace(/\bkhối khí\s*\(E\)/gi, 'khối khí xích đạo E');
      normalized = normalized.replace(/➔|->/g, 'dẫn đến');
      normalized = normalized.replace(/&/g, 'và');
      normalized = normalized.replace(/[\*\#]/g, '');
      return normalized.trim();
    }

